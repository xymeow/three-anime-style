{
  "name": "@xymeow/three-anime-style",
  "version": "0.4.1",
  "description": "Anime-style rendering for Three.js: cel shading, painted backgrounds, outlines and film effects. Browser demos and AI-agent integration skill included.",
  "type": "module",
  "license": "MIT",
  "author": "xymeow",
  "repository": {
    "type": "git",
    "url": "https://github.com/xymeow/three-anime-style.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build:demo": "vite build",
    "prepare": "npm run build",
    "format": "prettier --write docs src demo lab lab.html tests scripts index.html vite.config.ts *.json *.md skills .github",
    "format:check": "prettier --check docs src demo lab lab.html tests scripts index.html vite.config.ts *.json *.md skills .github",
    "build:lab": "npm run build:demo"
  },
  "peerDependencies": {
    "three": "~0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "prettier": "3.6.2",
    "three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "homepage": "https://xymeow.github.io/three-anime-style/",
  "keywords": [
    "threejs",
    "anime",
    "cel-shading",
    "toon-shading",
    "shader",
    "postprocessing",
    "agent-skill"
  ]
}
